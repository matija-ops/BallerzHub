{
  "version": 8,
  "name": "Basketball Dark",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#376f65"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "farmland", "#4b806c",
          "grass", "#3f7d68",
          "wood", "#17685f",
          "wetland", "#1d716b",
          "#2f7467"
        ]
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 5,
      "filter": ["in", ["get", "class"], ["literal", ["residential", "commercial", "industrial", "retail"]]],
      "paint": {
        "fill-color": "#405a6b",
        "fill-opacity": 0.72
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#243b55"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#2b73a3",
        "line-width": 1
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#4d4770",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "paint": {
        "line-color": "#60738a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.5,
          10,
          1.5,
          15,
          4
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#2b3e53",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          1.5,
          10,
          3,
          15,
          8
        ]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary"],
      "paint": {
        "line-color": "#869bb3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1, 10, 2, 15, 6]
      }
    },
    {
      "id": "country-boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 4,
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#b04770",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 1.2, 8, 2, 12, 3, 16, 4],
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 4, 0.75, 8, 0.9, 12, 1]
      }
    },
    {
      "id": "state-boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 6,
      "filter": ["==", ["get", "admin_level"], 4],
      "paint": {
        "line-color": "#9f3c65",
        "line-width": 1.2,
        "line-dasharray": [2, 1.5],
        "line-opacity": 0.85
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 16, 13],
        "text-letter-spacing": 0.04,
        "text-keep-upright": true
      },
      "paint": {
        "text-color": "#cbd9e8",
        "text-halo-color": "#34465c",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "poi-marker",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "filter": ["all", ["has", "name"], ["<=", ["get", "rank"], 6]],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 14, 3, 17, 5],
        "circle-color": [
          "match",
          ["get", "class"],
          "park", "#50c878",
          "hospital", "#ef6d7d",
          "school", "#d7a56a",
          "stadium", "#45b9d5",
          "fuel", "#e0b842",
          "#8eb0d1"
        ],
        "circle-stroke-color": "#172434",
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 15,
      "filter": ["all", ["has", "name"], ["<=", ["get", "rank"], 6]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-offset": [0, 0.9],
        "text-anchor": "top"
      },
      "paint": {
        "text-color": "#d7e3ef",
        "text-halo-color": "#34465c",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "traffic-signals",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 17,
      "filter": ["==", ["get", "subclass"], "traffic_signals"],
      "paint": {
        "circle-radius": 3,
        "circle-color": "#f3c84b",
        "circle-stroke-color": "#202a37",
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 8,
      "filter": [
        "any",
        ["==", ["get", "capital"], 2],
        [
          "all",
          ["==", ["get", "class"], "city"],
          ["<=", ["get", "rank"], 3]
        ]
      ],
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          10,
          10,
          13,
          15,
          16
        ]
      },
      "paint": {
        "text-color": "#d7e3ef",
        "text-halo-color": "#34465c",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label-local",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "layout": {
        "text-field": "{name:latin}",
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          10,
          10,
          13,
          15,
          16
        ]
      },
      "paint": {
        "text-color": "#d7e3ef",
        "text-halo-color": "#34465c",
        "text-halo-width": 1
      }
    }
  ]
}
